# Copier en ".env" a la racine. NE JAMAIS commiter ".env".
# ATTENTION : les mots de passe des services doivent correspondre a ceux de
# infra/postgres/init/01-init-schemas.sql (valeurs de developpement).

POSTGRES_ADMIN_PASSWORD=admin_pass

# pgAdmin (Interface Web d'administration)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=

CHAMBRES_DB_PASSWORD=chambres_pass
AVIS_DB_PASSWORD=avis_pass
DISPONIBILITES_DB_PASSWORD=disponibilites_pass
TARIFS_DB_PASSWORD=tarifs_pass

AUTH_DB_PASSWORD=auth_pass

# Meme valeur dans TOUS les services (JWT HS256). Longue et aleatoire.
JWT_SECRET=change_me_long_random_secret

# disponibilites-service : true = fausse reponse pour chambres-service (dev local seulement)
CHAMBRES_MOCK=false
