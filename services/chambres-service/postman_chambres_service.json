                {
                    "name": "GET /api/chambres/1 (Appel depuis Tarifs / Disponibilités)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200 (Chambre existe)\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test(\"Payload has required fields for price calculation\", function () {",
                                    "    var chambre = pm.response.json().data;",
                                    "    pm.expect(chambre.id).to.eql(1);",
                                    "    pm.expect(chambre.prix_nuit).to.be.a(\"number\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "User-Agent",
                                "value": "HotelHub-TarifsService/1.0"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/chambres/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "chambres",
                                "1"
                            ]
                        }
                    }
                },
                {
